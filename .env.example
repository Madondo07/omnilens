# --- .env (committed) ---
# Public, client-safe values only. Lovable needs these present at build time
# to generate previews and published builds — do not gitignore this file.
VITE_SUPABASE_PROJECT_ID=""
VITE_SUPABASE_PUBLISHABLE_KEY=""
VITE_SUPABASE_URL=""

# --- .env.local (gitignored, local dev only) ---
# Real secrets. For the deployed app on Lovable, set this in
# Cloud tab -> Secrets instead — never commit it.
# GOOGLE_GENERATIVE_AI_API_KEY="" — get one at https://aistudio.google.com/apikey
